# Copy to `.env.test`. Server tests must only ever touch this database.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next_template_test"

# Better Auth: generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-with-a-32+-character-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Redis: tests use database 15 and flush it, never point this at a database you care about.
REDIS_URL="redis://localhost:6379/15"

# Email: unset RESEND_API_KEY so tests never send mail.
# RESEND_API_KEY=""
EMAIL_FROM="Next Template <noreply@example.com>"

# S3-compatible storage (tests mock it; values only need to validate).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="next-template-test"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_URL="http://localhost:9000/next-template-test"
# S3_PUBLIC_ENDPOINT="http://localhost:9000"

# Google sign-in (optional; set both or neither). Tests leave it off: no test reaches Google.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
