// Better Auth settings this schema depends on:
//   advanced: { database: { generateId: "uuid" } }
//     Ids then come from @default(uuid(7)) below. Without it sign-up fails,
//     because Better Auth sends its own non-UUID string ids.
//   admin({ ..., defaultRole: "user" })
//     Role names and the default must match users.role and its CHECK constraint.
//
// The init migration adds by hand what Prisma can't express: the CHECK constraint
// users_role_valid on users.role. Add later constraints the same way, in their own migration.
//
// Ids are UUIDv7 generated by Prisma Client, not by the database, and `@updatedAt`
// is filled by Prisma Client too: neither column has a DEFAULT, so raw SQL inserts
// must supply both `id` and `updated_at`.
//
// Create users through Better Auth (auth.api.createUser / signUpEmail), never by
// inserting rows: the password hash lives in accounts, in Better Auth's format.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// Better Auth owns User, Session, Account and Verification: model and field names are its
// contract and must not be renamed; table and column names are remapped with @@map / @map.

/// Better Auth's user, plus the fields of its `admin` plugin (`role`, `banned`, `banReason`,
/// `banExpires`) and this app's own `username` and `website`.
model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  /// Always lowercase (the sign-up rule), so the unique index is effectively case-insensitive.
  username      String    @unique
  website       String?
  /// `user` or `admin` (`roleSchema` in `lib/dto/users.ts`). Text, not an enum: the admin plugin
  /// filters it with string operators. The allowed set is the users_role_valid CHECK constraint;
  /// the default must match `defaultRole`.
  role          String    @default("user")
  banned        Boolean   @default(false)
  banReason     String?   @map("ban_reason")
  banExpires    DateTime? @map("ban_expires") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  posts         Post[]

  @@map("users")
}

model Session {
  id             String   @id @default(uuid(7)) @db.Uuid
  token          String   @unique
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The admin who opened this session through the admin plugin's impersonation, if any. No
  /// foreign key: Better Auth declares none, and these sessions expire within the hour.
  impersonatedBy String?  @map("impersonated_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  // The hourly cleanup job deletes by expiry (`deleteExpiredAuthRows`).
  @@index([expiresAt])
  @@map("sessions")
}

/// Email + password is the row with providerId = "credential"; its `password` holds the hash.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id") @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Not in Better Auth's own schema: one external identity maps to at most one row.
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  // The hourly cleanup job deletes by expiry (`deleteExpiredAuthRows`).
  @@index([expiresAt])
  @@map("verifications")
}

/// The example resource. Only published posts are public; a draft is visible to its author and admins.
model Post {
  id        String   @id @default(uuid(7)) @db.Uuid
  title     String
  body      String
  published Boolean  @default(false)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId])
  @@index([published, createdAt, id])
  @@map("posts")
}
