{
  "name": "next-template",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "contract:emit": "prisma contract emit",
    "db:migrate": "prisma contract emit && prisma migration plan && prisma db migrate --advance-ref db",
    "db:deploy": "prisma db migrate --no-interactive",
    "db:seed": "node prisma/seed.ts",
    "db:studio": "prisma db schema",
    "db:test:prepare": "DOTENV_CONFIG_PATH=.env.test DOTENV_CONFIG_OVERRIDE=true node prisma/reset-test-db.ts && DOTENV_CONFIG_PATH=.env.test DOTENV_CONFIG_OVERRIDE=true prisma db migrate --no-interactive"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/orm-postgres": "8.0.0-rc.14",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@prisma/cli-engine": "0.6.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "dotenv": "^18.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prisma": "8.0.0-rc.19",
    "sass": "^1.105.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.3.10",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "overrides": {
    "@prisma/orm-toolchain": "8.0.0-rc.14"
  }
}
