# Copy to `.env` and adjust. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next_template_dev"
NEXT_PUBLIC_APP_NAME="Next Template"
# NEXT_PUBLIC_API_BASE_URL=/api/v1

# Better Auth: generate the secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET="replace-with-a-32+-character-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Redis (data cache + rate limiter).
REDIS_URL="redis://localhost:6379/0"

# Email: Resend. Leave RESEND_API_KEY unset to log emails to the console instead.
# RESEND_API_KEY=""
EMAIL_FROM="Next Template <noreply@example.com>"

# S3-compatible storage (MinIO in dev, see docker-compose.yml).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="next-template"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_URL="http://localhost:9000/next-template"
