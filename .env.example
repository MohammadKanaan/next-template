# Copy to `.env` and adjust. Requires PostgreSQL >= 15.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next_template_dev"
NEXT_PUBLIC_APP_NAME="Next Template"
# NEXT_PUBLIC_API_BASE_URL=/api/v1

# Logging (pino). Defaults to debug in development, info in production, silent in tests.
# LOG_LEVEL="info"

# Better Auth: you must generate the secret yourself (`openssl rand -base64 32`). Production refuses
# to start without one (at least 32 characters) or with a placeholder value.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Redis (data cache + rate limiter).
REDIS_URL="redis://localhost:6379/0"

# Email: Resend. Leave RESEND_API_KEY unset (or empty) in dev to log emails to the console; production requires it.
# RESEND_API_KEY=""
EMAIL_FROM="Next Template <noreply@example.com>"

# S3-compatible storage (MinIO in dev, see docker-compose.yml).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="next-template"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_PUBLIC_URL="http://localhost:9000/next-template"
# Optional: the S3 endpoint as the browser reaches it (presigned uploads). Defaults to S3_ENDPOINT;
# set it when S3_ENDPOINT is an internal host such as http://minio:9000.
# S3_PUBLIC_ENDPOINT="http://localhost:9000"

# Optional: how many reverse proxies in front of the app append the client address to
# x-forwarded-for (per-IP rate limits trust the entry that many from the end). Defaults to 1.
# TRUSTED_PROXY_HOPS=1

# Google sign-in (optional; set both or neither). Create an OAuth client in Google Cloud Console and
# add the authorized redirect URI <BETTER_AUTH_URL>/api/auth/callback/google
# (http://localhost:3000/api/auth/callback/google in dev). Tests never need them.
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""

# Web Push (optional; set all three or none). Generate the keys with `bunx web-push generate-vapid-keys`.
# VAPID_SUBJECT is a mailto: or https: contact for the push services. Tests never need them.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
